{
  "name": "@josstei/maestro",
  "version": "1.6.4",
  "description": "Multi-agent development orchestration platform — 39 specialists, 4-phase workflows, 5 runtime targets (Gemini CLI, Claude Code, OpenAI Codex, Qwen Code, opencode)",
  "license": "Apache-2.0",
  "author": {
    "name": "josstei",
    "email": "hello@josstei.dev",
    "url": "https://github.com/josstei"
  },
  "homepage": "https://github.com/josstei/maestro-orchestrate",
  "repository": {
    "type": "git",
    "url": "https://github.com/josstei/maestro-orchestrate.git"
  },
  "bin": {
    "maestro-install-codex": "./scripts/install-codex-plugin.js",
    "maestro-install-opencode": "./scripts/install-opencode-plugin.js",
    "maestro-mcp-server": "./bin/maestro-mcp-server.js"
  },
  "scripts": {
    "generate": "node scripts/generate.js",
    "build": "npm run generate",
    "test": "node --test tests/unit/*.test.js tests/transforms/*.test.js tests/integration/*.test.js",
    "coverage": "c8 npm test",
    "test:coverage": "npm run coverage",
    "lint": "eslint . --max-warnings 0",
    "sast": "eslint -c eslint.sast.config.js . --max-warnings 0",
    "sca": "npm audit --audit-level=high",
    "quality": "eslint -c eslint.quality.config.js . --max-warnings 0 && node scripts/check-layer-boundaries.js",
    "regression": "node --test tests/integration/*.test.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run lint && npm run quality && npm run sast && npm run sca && npm run coverage && npm run regression && npm run smoke",
    "release:artifacts": "node scripts/package-release-artifacts.js --out-dir dist/release",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.js",
    "pack:verify": "node scripts/verify-npm-pack.js",
    "install-hooks": "node scripts/install-git-hooks.js",
    "prepack": "npm run generate"
  },
  "c8": {
    "all": true,
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "include": [
      "src/**/*.js",
      "scripts/**/*.js",
      "bin/**/*.js"
    ],
    "exclude": [
      "**/*.test.js",
      "scripts/smoke.js"
    ],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.12.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "orchestration",
    "multi-agent",
    "planning",
    "execution",
    "gemini",
    "claude",
    "codex",
    "opencode",
    "mcp"
  ],
  "files": [
    "EXAMPLES.md",
    "src/",
    "scripts/",
    "bin/",
    "agents/",
    "claude/",
    "plugins/",
    "commands/",
    "hooks/",
    "mcp/",
    "opencode/",
    "policies/",
    "docs/architecture.md",
    "docs/cicd.md",
    "docs/flow.md",
    "docs/maestro-cheatsheet.md",
    "docs/overview.md",
    "docs/runtime-claude.md",
    "docs/runtime-codex.md",
    "docs/runtime-gemini.md",
    "docs/runtime-qwen.md",
    "docs/runtime-opencode.md",
    "docs/usage.md",
    ".agents/",
    "GEMINI.md",
    "gemini-extension.json",
    "QWEN.md",
    "qwen-extension.json",
    "qwen/",
    "CHANGELOG.md"
  ]
}
